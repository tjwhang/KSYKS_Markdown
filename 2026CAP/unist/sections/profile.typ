#import "../portfolio.typ": *

#let profile = (
    pages: (
        [
            #place(bottom+right, dx: 3%, dy: 1%, image("../assets/intro.png", width: 74%))
            #move(
                dx: 3em,
                block(
                    width: 38em,
                )[
                    #align(
                        left,
                    )[
                        #set par(first-line-indent: (all: true, amount: 1em))

                        제 관심 분야는 처음부터 넓었던 것이 아니라, 하나의 질문을 끝까지 따라가다 보니 넓어졌습니다.

                        중학생 때 양자역학을 교양서적으로 접한 뒤 관련 내용을 탐독하고, 보다 제대로 이해해 보고 싶었습니다. 마침 도서관 구석에 다른 책들과 달리 정직한 제목을 가진 "Introduction to Quantum Mechanics"가 꽂혀있었습니다. '그래, 양자역학에 입문하고 싶다!'라는 생각으로 집어들어들었지만 파인만의 경고를 무시하고 고양이가 그려진 붉은 표지를 넘기자마자 첫 장부터 슈뢰딩거 방정식이 등장했고, 사실상 기초적인 미분도 할 줄 몰랐던 저는 거의 아무것도 알아볼 수 없었습니다. 하지만 책을 덮고 싶지는 않았습니다. 오히려 알고 싶다는 강한 매력을 느꼈고, 모르는 내용을 알기 위해 수학과 물리 개념을 공부하며 점차 서로 관계없어 보이던 개념들이 하나의 유기적 체계로 구성되는 과정에서 큰 쾌감을 느꼈습니다.

                        고등학교에서는 이미 알려진 내용을 찾아 정리하고 이해하는 데서 한 걸음 더 나아가, 궁금한 것을 제 능력 안에서 직접 다룰 수 있는 문제로 만들어 보고 싶었습니다. 수학에서는 흥미롭지만 아주 특정한 문제 상황을 만들어 해결하거나 일반식을 유도해 보았습니다. 물리에서는 현상을 제가 다룰 수 있는 수리적 문제로 단순화하려는 시도를 했습니다. 사회와 언어처럼 대상이 수치로 나타나기 어려워 보이는 분야에서도, 정성적으로 설명되는 현상을 어떤 규칙이나 수치로 표현할 수 있을지 생각해 보았습니다.

                        물론 처음 세웠던 모형과 그에 의한 결론이 항상 옳았던 것은 아닙니다. 오히려 가정 자체가 잘못되었거나 논리 전개 과정에서 비약이나 계산 오류가 있는 경우가 많았습니다. 하지만 그런 경험이 반복되면서 결과뿐 아니라, 무엇을 단순화했고 어떤 조건에서 그러한 결과가 도출되었는지를 다시 확인하는 과정을 중시하게 되었습니다.

                        #jsquote[
                            현상에 주목하고, 다룰 수 있는 문제로 바꾸고, 필요한 지식을 습득하고, 계산하거나 구현한 뒤, 다시 처음의 가정으로 돌아가 검토하기
                        ]

                        제가 여러 분야에서 거듭해 온 탐구는 대체로 이 과정을 따르고 있습니다. 앞으로 포트폴리오에 등장하는 수식, 코드 등은 각각의 질문을 해결하기 위해 필요했던 도구들이자 핵심 과정들입니다. 본 포트폴리오에서는 서로 다른 분야의 결과를 나열하기보다, 하나의 관찰이 질문이 되고, 질문이 정식화된 문제로 바뀌며, 그 과정에서 다시 새로운 질문으로 연결되는 과정을 보여드리고자 합니다.
                    ]
                ],
            )

        ],
        [
            #pf-columns(
                gutter: pf-profile-gutter,
                left: [
                    #pf-label[개요]
                    #v(0.55em)
                    #set par(first-line-indent: 1em)
                    본격적인 탐구활동 소개에 앞서, 이 포트폴리오의 구성에 대한 부연 설명과 제 관심분야를 간략히 소개하고자 합니다.

                    *포트폴리오는 크게 이학, 인문사회, 타이포그래피의 세 부분으로 구성했습니다. 각 탐구를 핵심 질문과 과정, 결과 및 재검토 사항으로 2\~4쪽으로 재구성한 것이 기재되어 있습니다.* 먼저 제가 가장 오래 관심을 가져온 이학 분야에서는 수행한 탐구 중 두 가지를 선정했습니다. 이학 탐구를 거듭하며 현상을 수리적으로 단순화하거나 모형화하여 계산 가능한 문제로 만들고, 때로는 서로 다른 분야를 연계해 결론을 도출하는 것을 하나의 방법으로 삼게 되었습니다. 이러한 방법은 다른 분야를 다루는 탐구에서도 일관되게 적용할 수 있는 기틀이 되었습니다.

                    다음으로는 평소 관심이 깊었던 언어·사회·철학 등의 문제에도 이러한 방식을 적용해, 주로 정성적으로 다루어지는 개념을 수치화하거나 모형으로 표현해 본 탐구를 소개합니다. 경제학과 사회과학 등에서 이미 여러 정량적 방법을 사용하고 있지만, 이러한 접근을 다른 인문사회적 문제에도 확대하여 적용하면 정성적 논의를 다른 관점에서 검토하고 보완해 보다 좋은 결과가 도출될 수 있을 것이라고 생각합니다.

                    마지막에는 언어에 대한 관심이 확장되면서 시작한 타이포그래피 탐구와, 그 결과를 실제 문서에 적용하기 위해 제작해 온 CJK 조판 시스템을 소개하고자 합니다. 본 포트폴리오도 해당 조판 시스템을 개조하여 제작되었습니다.

                    옆 단에는 제가 지속적으로 관심을 가지고 몰입했던 분야들을 간략히 정리해 보았습니다. 포트폴리오 본문이 탐구활동과 그 결과를 중심으로 구성되어 있다면, 이 부분은 별도의 증빙이나 성과를 제시하기보다 제가 어떤 분야에 관심을 가져 왔는지의 전반적 경향과, 포트폴리오에 기재된 활동을 시작하게 된 배경에 관한 내용으로 구성했습니다.
                ],
                right: [
                    #pf-label[배경]
                    #v(0.55em)
                    #stack(
                        spacing: 1em,
                        [
                            #strong[이학 전반] #h(0.8em)
                            현재는 제가 좋아하는 물리와 컴퓨터과학의 융합인 동시에 요즘 각광받고 있는 문제 여럿을 효과적으로 풀어낼 수 있는 양자컴퓨팅에 관심이 많습니다. 알고리즘뿐 아니라 이를 실제로 구현하는 물리계와 소자로도 관심을 넓히고 있습니다.
                        ],
                        [#strong[소프트웨어] #h(0.8em)
                            초등학교 때 블록 코딩으로 입문해 컴퓨터가 제가 내린 명령에 의해 동작한다는 것에 매력을 느끼고 한때 개발자를 진로로 꿈꾸기도 했습니다. 그때 공부했던 백엔드 및 프론트엔드 스택은 현재 계산, 시각화, 자료처리, 문서제작 등에 큰 도움이 되어주고 있습니다. 이러한 도구적 면모와 별개로 양자컴퓨팅에 관심을 가지면서 저수준에서의 작동방식과 알고리즘, 자료구조에도 다시 관심을 두고 있습니다.
                        ],
                        [#strong[언어·문화] #h(0.8em)
                            언어의 체계성과 의미 전달 방식 자체에 흥미를 가지고 있으며, 여러 관심분야의 자료를 폭넓게 접하고 사고의 폭을 넓힐 수 있다는 점에서 외국어 학습에도 열정을 가졌습니다. 영어는 자유롭게 사용할 수 있고 일본어, 러시아어로 된 기초적인 자료를 읽을 수 있으며 이러한 언어들 자체, 특히 한국어와 일본어의 역사와 구조적 특징 등에 관심이 많습니다. 최근에는 일본어가 어느 정도 능숙해지게 되며 제가 접근할 수 있는 양질의 자료가 급증하여, 공부에 큰 도움을 주고 있습니다. 또한 외국인을 대상으로 문화유산해설을 하는 봉사활동을 다년간 수행하며#footnote[국제교류문화진흥원 산하 청소년문화단 297기로 활동했습니다. 자격증은 규정에 따라 첨부하지 않겠습니다.] 동양의 역사와 문화를 익히고 외국어 능력을 함양하며 각국의 다양한 분들과 교류하였습니다.
                        ],
                        [#strong[기타] #h(0.8em)
                            영상편집·VFX·애니메이션과 게임 개발에도#footnote[과거 제작물 일부: https://youtu.be/w_pAUOBqqd4] 오랫동안 관심을 가져 관련 이론과 도구를 익히고 작업한 경험이 있습니다.
                        ],
                    )
                ],
            )
        ],
    ),
)
